# Environment variables template for tx scripts
# Copy to .env.local and fill values. Do NOT commit secrets like private keys.

# Source address (optional)
ADDRESS=

# Raw transaction hex (un-signed or signed depending on workflow)
HEX=

# Destination (receive) address
RECEIVE_ADDRESS=

# Change address
CHANGE_ADDRESS=

# Network: mainnet or testnet
NETWORK=mainnet

# Whether to actually broadcast when using scripts (set false for testing)
BROADCAST=false
